class Solution {
    public int[] concatWithReverse(int[] arr) {
        int n = arr.length;
        int[] result = new int[2 * n];
        for (int i = 0; i < n; i++) {
            result[i] = arr[i];
        }
        for (int i = 0; i < n; i++) {
            result[n + i] = arr[n - 1 - i];
        }
        return result;
    }
}
