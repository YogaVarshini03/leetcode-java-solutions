class Solution {
    public int findNumbers(int[] nums) {
        int sum=0;
        for(int b:nums){
            int c=0;
            while(b>0){
                b=b/10;
                c=c+1;
            }
            if(c%2==0){
                sum=sum+1;
            }
        }
        return sum;
    }
}
