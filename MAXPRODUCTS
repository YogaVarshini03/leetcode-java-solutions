class Solution {
    public int maxProduct(int[] nums) {
        int firstMax = 0;   // biggest number
        int secondMax = 0;  // second biggest number

        for (int num : nums) {
            if (num > firstMax) {
                secondMax = firstMax;
                firstMax = num;
            } else if (num > secondMax) {
                secondMax = num;
            }
        }

        return (firstMax - 1) * (secondMax - 1);
    }
}

